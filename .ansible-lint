---
# ansible-lint configuration.
#
#   venv/bin/ansible-lint
#
# One skip below, and one inline '# noqa' in the whole tree
# (roles/underlay_readiness/tasks/04_apply_baseline.yml). Each has its reasoning
# written next to it -- if you need another, write down why rather than adding
# it silently.
#
# Role directory names use underscores because ansible-lint's role-name rule
# requires ^[a-z][a-z0-9_]*$. Hyphens work fine when a role is resolved by
# path, but the underscore form is what Galaxy and collections require, so the
# names are already correct if this ever becomes either.

exclude_paths:
  - venv/
  - old files/            # pre-rewrite material, kept for reference, not linted
  - switch-configuration/ # rendered device configs, not source
  - .github/
  # Offline test harnesses and their static inventories. Each harness imports a
  # task file that does not exist here: the tests extract it from the shipped
  # role at run time into a temp directory, so the tasks under test are the ones
  # that ship rather than a copy. Linting a harness standalone therefore fails on
  # a missing include, and the .ini fixtures are inventory rather than source in
  # any case.
  - roles/acm_evpn/tests/fixtures/
  - roles/underlay_readiness/tests/fixtures/

skip_list:
  # var-naming[no-role-prefix]: wants every variable a role defines to be
  # prefixed with the role name -- acm_evpn_evpn_l2vni_base,
  # underlay_readiness_readiness_global_lines.
  #
  # That rule is written for independently reusable Galaxy roles, where an
  # unprefixed variable can collide with an unrelated role in the same play.
  # These two roles are halves of one system and share a vocabulary on purpose:
  # 'readiness_enforce' is defined in underlay_readiness/defaults and SET by
  # acm_evpn/tasks/generate_only.yml; the per-fabric values both roles read
  # (fabric_asn, fabric_rp_address, fabric_rp_interface) are resolved from
  # NetBox by underlay_readiness and consumed by acm_evpn; and the conventions
  # arrive unprefixed from group_vars/all/main.yml (vtep_source_intf). Prefixing
  # would split one coherent namespace in three and stutter every name, while
  # colliding with nothing.
  #
  # Only this sub-rule is skipped. var-naming's other checks -- reserved names,
  # invalid identifiers, writing to read-only vars -- stay on, because those
  # catch real bugs.
  - var-naming[no-role-prefix]
